    <script>



        // -----------------------------
        // Cycle: esconder tópicos concluídos (toggle)
        // -----------------------------
        let hideDoneTopicsInCycle = false;
        try { hideDoneTopicsInCycle = JSON.parse(localStorage.getItem('study_cycle_hide_done_topics_v1')) || false; }
        catch { hideDoneTopicsInCycle = false; }

        function toggleHideDoneTopicsInCycle() {
            hideDoneTopicsInCycle = !hideDoneTopicsInCycle;
            localStorage.setItem('study_cycle_hide_done_topics_v1', JSON.stringify(hideDoneTopicsInCycle));
            if (isMobileViewport()) renderMobileView(); else renderTopics();
        }

        function showSessionModal(k, presetType = 'questions', afterSave = null) {
            ensure(k);
            const info = parseStorageKey(k);
            if (!info || !edital[info.sIdx]?.topicos?.[info.tIdx]) return;
            const subject = edital[info.sIdx];
            const topic = subject.topicos[info.tIdx];
            const scheduledReview = presetType === 'review' && typeof afterSave === 'function';
            const sessionTypeBlock = scheduledReview
                ? `<div class="p-3 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-900/30">
                    <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500">Tipo de sessão</div>
                    <div class="text-sm font-bold text-indigo-800 dark:text-indigo-200 mt-1">Revisão programada pela Agenda</div>
                  </div>`
                : `<fieldset class="p-3 rounded-xl border border-gray-200 dark:border-gray-700">
                    <legend class="px-1 text-xs font-bold text-gray-600 dark:text-slate-300">Tipo de sessão</legend>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1 text-xs font-semibold text-gray-700 dark:text-slate-200">
                      <label class="flex items-center gap-2"><input type="radio" name="session-type" value="first" class="accent-indigo-600" /> Primeiro contato</label>
                      <label class="flex items-center gap-2"><input type="radio" name="session-type" value="questions" class="accent-indigo-600" /> Questões</label>
                      <label class="flex items-center gap-2"><input type="radio" name="session-type" value="random" class="accent-indigo-600" /> Teste aleatório</label>
                    </div>
                  </fieldset>`;
            const modal = document.getElementById('custom-modal');
            const title = document.getElementById('modal-title');
            const message = document.getElementById('modal-message');
            const footer = document.getElementById('modal-footer');
            if (!modal || !title || !message || !footer) return;

            title.innerText = 'Registrar sessão de estudo';
            message.innerHTML = `
        <div class="space-y-3 max-h-[65vh] overflow-y-auto pr-1">
          <div class="p-3 rounded-xl bg-indigo-50 dark:bg-indigo-900/30">
            <div class="text-[10px] font-bold uppercase text-indigo-500">${escapeHtml(subject.materia)}</div>
            <div class="text-sm font-semibold text-gray-800 dark:text-slate-100">${escapeHtml(topic)}</div>
          </div>
          ${sessionTypeBlock}
          <div class="grid grid-cols-2 gap-3">
            <label class="text-xs font-bold text-gray-600 dark:text-slate-300">Questões
              <input id="session-questions" type="number" min="0" value="0" class="mt-1 w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-950 border dark:border-gray-700 text-sm" />
            </label>
            <label class="text-xs font-bold text-gray-600 dark:text-slate-300">Acertos
              <input id="session-correct" type="number" min="0" value="0" class="mt-1 w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-950 border dark:border-gray-700 text-sm" />
            </label>
          </div>
          <label class="flex items-center gap-2 text-xs font-semibold text-gray-600 dark:text-slate-300"><input id="session-consulted" type="checkbox" class="accent-indigo-600" /> Consultei o material antes de responder</label>
          <fieldset class="p-3 rounded-xl border border-gray-200 dark:border-gray-700">
            <legend class="px-1 text-xs font-bold text-gray-600 dark:text-slate-300">Caderno de erros</legend>
            <label class="flex items-center gap-2 pt-1 text-xs font-semibold text-gray-700 dark:text-slate-200">
              <input id="include-error-notebook" type="checkbox" class="accent-indigo-600" />
              Incluir no caderno de erros?
            </label>
            <p class="mt-2 text-[10px] text-gray-500 dark:text-slate-400">Ao incluir, a primeira revisão será agendada automaticamente para daqui a 3 dias.</p>
          </fieldset>
        </div>`;
            const allowedSessionTypes = scheduledReview ? ['review'] : ['first', 'questions', 'random'];
            const selectedSessionType = allowedSessionTypes.includes(presetType) ? presetType : 'questions';
            const presetRadio = document.querySelector(`input[name="session-type"][value="${selectedSessionType}"]`);
            if (presetRadio) presetRadio.checked = true;
            footer.innerHTML = '';
            const cancel = document.createElement('button');
            cancel.type = 'button'; cancel.innerText = 'Cancelar';
            cancel.className = 'px-5 py-2 rounded-xl text-sm font-semibold bg-gray-100 text-gray-700';
            cancel.onclick = () => {
                modal.style.display = 'none';
                renderTopics();
            };
            const saveBtn = document.createElement('button');
            saveBtn.type = 'button'; saveBtn.innerText = 'Salvar sessão';
            saveBtn.className = 'px-5 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white';
            saveBtn.onclick = () => {
                const questions = Math.max(0, Number(document.getElementById('session-questions')?.value) || 0);
                const correct = Math.max(0, Number(document.getElementById('session-correct')?.value) || 0);
                if (correct > questions) { showModal('Erro', 'Os acertos não podem ser maiores que a quantidade de questões.'); return; }
                const now = Date.now();
                const errorReviewDays = document.getElementById('include-error-notebook')?.checked ? [3] : [];
                const session = normalizeSession({
                    id: `S_${now}_${Math.random().toString(36).slice(2, 8)}`,
                    at: now,
                    type: scheduledReview ? 'review' : (document.querySelector('input[name="session-type"]:checked')?.value || selectedSessionType),
                    questions,
                    correct,
                    errors: Math.max(0, questions - correct),
                    consulted: !!document.getElementById('session-consulted')?.checked,
                    difficulty: 'medium',
                    errorType: '',
                    note: '',
                    errorReviewDays,
                    errorReviewDone: {}
                });
                const st = userProgress[k];
                st.sessions.push(session);
                st.q = true;
                if (!st.aulaAt) st.aulaAt = now;
                // Apenas revisões programadas/registradas como revisão alteram o relógio de revisão.
                // Questões e testes aleatórios alimentam desempenho/prioridade, mas não deslocam a Agenda.
                if (session.type === 'review') {
                    st.countR = (st.countR || 0) + 1;
                    st.revAt.push(now);
                    st.lastR = now;
                } else if (!st.lastR) {
                    st.lastR = st.aulaAt || null;
                }
                const pct = recentTopicPercent(st);
                if (pct !== null) st.pct = pct;
                const ev = masteryEvidence(st);
                if (isLearningStatusEnabled('strong') && ev.probable) st.dominated = true;
                if (typeof afterSave === 'function') afterSave(session);
                moveTopicToEnd(info.sIdx, info.tIdx);
                moveSubjectToEnd(info.sIdx);
                modal.style.display = 'none';
                save();
            };
            footer.append(cancel, saveBtn);
            modal.style.display = 'flex';
        }


        async function copyTopicReference(sIdx, tIdx, button) {
            const subject = edital?.[sIdx];
            const topic = subject?.topicos?.[tIdx];
            if (!subject || !topic) return;
            const rawTopic = String(topic || '').trim();
            const numbered = rawTopic.match(/^(\d+(?:\.\d+)*)(?:[.)])?\s*(.*)$/);
            const formattedTopic = numbered
                ? `${numbered[1]}.${numbered[2] ? ' ' + numbered[2].trim() : ''}`
                : rawTopic;
            const text = `${String(subject.materia || '').trim()} - ${formattedTopic}`;

            try {
                if (navigator.clipboard?.writeText) {
                    await navigator.clipboard.writeText(text);
                } else {
                    const area = document.createElement('textarea');
                    area.value = text;
                    area.style.position = 'fixed';
                    area.style.opacity = '0';
                    document.body.appendChild(area);
                    area.select();
                    document.execCommand('copy');
                    area.remove();
                }
                if (button) {
                    const originalIcon = button.dataset.originalIcon || button.innerHTML;
                    button.dataset.originalIcon = originalIcon;
                    if (button._copyResetTimer) clearTimeout(button._copyResetTimer);
                    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
                    button.title = 'Copiado';
                    button.setAttribute('aria-label', 'Copiado');
                    button._copyResetTimer = setTimeout(() => {
                        button.innerHTML = originalIcon;
                        button.title = 'Copiar matéria e tópico';
                        button.setAttribute('aria-label', 'Copiar matéria e tópico');
                        button._copyResetTimer = null;
                    }, 1800);
                }
            } catch (error) {
                console.error('Não foi possível copiar o tópico:', error);
            }
        }

        function activeSubjectAllowed(subject) {
            const wanted = normKey(learningConfig.activeTag);
            if (!wanted) return true;
            return normalizeTagsList(subject?.tags || []).some(t => normKey(t) === wanted);
        }

        function randomTestCandidates() {
            const now = Date.now();
            const minGap = 3 * 86400000;
            const out = [];
            edital.forEach((subject, sIdx) => {
                if (!activeSubjectAllowed(subject) || isHiddenInCycle(subject)) return;
                subject.topicos.forEach((topic, tIdx) => {
                    const k = `ST_${sIdx}_${tIdx}`;
                    const st = userProgress[k];
                    if (!st?.q) return;
                    const sessions = topicSessions(st);
                    const lastContact = Math.max(Number(st.lastR) || 0, sessions.length ? sessions[sessions.length - 1].at : 0, Number(st.aulaAt) || 0);
                    if (lastContact && now - lastContact < minGap) return;
                    const pct = recentTopicPercent(st);
                    const priority = subject.priority === 'important' ? 30 : subject.priority === 'primary' ? 15 : 0;
                    const subjectWeight = effectiveSubjectWeight(subject);
                    const weakness = isLearningStatusEnabled('fragile') ? (pct === null ? 20 : Math.max(0, 100 - pct)) : 0;
                    const overdue = lastContact ? Math.min(40, Math.floor((now - lastContact) / 86400000)) : 40;
                    out.push({ k, sIdx, tIdx, subject, topic, score: priority + (subjectWeight - 1) * 15 + weakness + overdue + Math.random() * 20 });
                });
            });
            return out.sort((a, b) => b.score - a.score);
        }

        function startRandomTest() {
            const candidates = randomTestCandidates();
            if (!candidates.length) {
                showModal('Teste aleatório', 'Nenhum tópico elegível agora. É necessário que o conteúdo esteja concluído, pertença à tag ativa e tenha pelo menos 3 dias desde o último contato.');
                return;
            }
            const pool = candidates.slice(0, Math.min(10, candidates.length));
            const picked = pool[Math.floor(Math.random() * pool.length)];
