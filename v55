        // -----------------------------
        // Rename subject
        // -----------------------------
        function renameSubjectByIndex(sIdx, newNameRaw) {
            const newName = (newNameRaw || "").toString().trim();
            if (!newName) return;

            const oldName = edital[sIdx]?.materia || "";
            if (!oldName) return;

            const newK = normKey(newName);
            const conflict = edital.some((s, i) => i !== sIdx && normKey(s.materia) === newK);
            if (conflict) {
                showModal("Erro", "Já existe uma matéria com esse nome.");
                return;
            }

            edital[sIdx].materia = newName;

            if (currentSubject === oldName) currentSubject = newName;

            save();
            showModal("Ok", `Matéria renomeada:\n${oldName}\n→ ${newName}`);
        }

