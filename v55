        function normalizeLine(s) {
            return (s || "").toString().replace(/\u00A0/g, " ").trim();
        }

        function isNumberedTopic(line) {
            return /^\d+(?:\.\d+)*[.)]?\s+/.test(line);
        }

        function looksLikeMateriaHeading(line) {
            const s = normalizeLine(line);
            if (!s) return false;
            if (isNumberedTopic(s)) return false;
            if (/\d/.test(s)) return false;
            if (s.length > 70) return false;
            if (/[.;:!?]$/.test(s)) return false;
            if (!/[A-Za-zÀ-ÿ]/.test(s)) return false;

            const words = s.split(/\s+/).filter(Boolean);
            if (words.length > 8) return false;

            const hasUpper = s === s.toUpperCase();
            return hasUpper; // só ALL CAPS vira matéria automaticamente
        }

        function splitPastedTextIntoSubjects(text) {
            const lines = (text || "")
                .split(/\r?\n/)
                .map(normalizeLine)
                .filter(Boolean);

            const out = [];
            let current = null;

            for (const line of lines) {
                const m = line.match(/^mat[eé]ria\s*:\s*(.+)$/i);
                if (m) {
                    const name = normalizeLine(m[1]);
                    if (name) {
                        current = { materia: name, topicos: [] };
                        out.push(current);
                    }
                    continue;
                }

                if (looksLikeMateriaHeading(line)) {
                    current = { materia: line, topicos: [] };
                    out.push(current);
                    continue;
                }

                if (!current) continue;

                if (isNumberedTopic(line)) {
                    current.topicos.push(line);
                    continue;
                }
                // ✅ certo: se não é numerado, ainda assim vira tópico (lista simples)
                const clean = normalizeLine(line);
                if (clean) current.topicos.push(clean);
            }


            // dedup + remove vazias
            return out
                .map(s => {
                    const seen = new Set();
                    s.topicos = s.topicos.filter(x => {
                        const k = x.toLowerCase();
                        if (seen.has(k)) return false;
                        seen.add(k);
                        return true;
                    });
                    return s;
                })
                .filter(s => s.materia && s.topicos.length);
        }

        function appendSubjectsToEdital(subjects) {
            if (!Array.isArray(subjects) || subjects.length === 0) return { added: 0, merged: 0 };

            const maxOrder = edital.reduce((mx, s) => Math.max(mx, Number.isFinite(s.order) ? s.order : 0), 0);
            let nextOrder = Math.min(100, maxOrder + 1);

            let added = 0;
            let merged = 0;

            for (const sub of subjects) {
                const name = (sub.materia || "").trim();
                if (!name) continue;

                const idx = edital.findIndex(s => (s.materia || "").trim().toLowerCase() === name.toLowerCase());

                if (idx === -1) {
                    edital.push({
                        materia: name,
                        topicos: Array.isArray(sub.topicos) ? sub.topicos.slice() : [],
                        priority: "primary", // "secondary" | "primary" | "important"
                        weight: 1,
                        examQuestions: 0,
                        order: nextOrder,
                        tags: [],
                    });
                    added++;
                    nextOrder = Math.min(100, nextOrder + 1);
                } else {
                    const s = edital[idx];
                    const existing = new Set((s.topicos || []).map(x => String(x).toLowerCase()));
                    const toAdd = (sub.topicos || []).filter(x => !existing.has(String(x).toLowerCase()));
                    if (toAdd.length) {
                        s.topicos = (s.topicos || []).concat(toAdd);
                        merged++;
                    }
                }
            }

            save();
            return { added, merged };
        }


