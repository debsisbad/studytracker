        // -----------------------------
        // Tags helpers
        // -----------------------------
        function normalizeTagsList(tags) {
            const arr = Array.isArray(tags) ? tags : [tags];

            const out = [];
            for (const item of arr) {
                const s = String(item ?? "").trim();
                if (!s) continue;

                const parts = s.split(/[,\n;|]+/g);
                for (const p of parts) {
                    const t = p.trim();
                    if (t) out.push(t);
                }
            }

            const seen = new Set();
            const uniq = [];
            for (const t of out) {
                const k = normKey(t);
                if (seen.has(k)) continue;
                seen.add(k);
                uniq.push(t);
            }
            return uniq;
        }

        function renderTagChips(tags) {
            return normalizeTagsList(tags)
                .map(tg => `<span class="tag-badge">${escapeHtml(tg)}</span>`)
                .join("");
        }

        function getAllUsedTags() {
            const byKey = new Map();

            edital.forEach((subject) => {
                normalizeTagsList(subject?.tags || []).forEach((tag) => {
                    const key = normKey(tag);
                    if (!key) return;

                    if (!byKey.has(key)) byKey.set(key, { tag, count: 0 });
                    byKey.get(key).count++;
                });
            });

            return [...byKey.values()].sort((a, b) =>
                a.tag.localeCompare(b.tag, 'pt-BR', { sensitivity: 'base' })
            );
        }

