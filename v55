        // -----------------------------
        let topicQueue = null;
        try { topicQueue = JSON.parse(localStorage.getItem('study_topic_queue_v1')) || {}; }
        catch { topicQueue = {}; }

        function topicQueueKey(sIdx) {
            return `Q_${sIdx}`;
        }

        function getDefaultTopicOrder(sIdx) {
            const s = edital?.[sIdx];
            if (!s || !Array.isArray(s.topicos)) return [];
            return s.topicos.map((_, i) => i); // ordem original do edital
        }

        function saveTopicQueue() {
            localStorage.setItem('study_topic_queue_v1', JSON.stringify(topicQueue || {}));
        }
        function skipCycleItem(e, sIdx, tIdx) {
            if (e) e.stopPropagation();
            if (viewMode !== 'cycle') return;

            // joga o tópico pro fim da fila da matéria
            moveTopicToEnd(sIdx, tIdx);

            // joga a matéria pro fim da fila do ciclo (round-robin)
            moveSubjectToEnd(sIdx);

            save();
        }

        // move um tIdx pro fim da fila
        function moveTopicToEnd(sIdx, tIdx) {
            const k = topicQueueKey(sIdx);
            const base = Array.isArray(topicQueue?.[k]) ? topicQueue[k].slice() : getDefaultTopicOrder(sIdx);

            const filtered = base.filter(x => x !== tIdx);
            filtered.push(tIdx);

            topicQueue[k] = filtered;
            saveTopicQueue();
        }
        function restoreTopicToDefaultPosition(sIdx, tIdx) {
            // pega a ordem atual da fila da matéria
            const order = getTopicOrderForSubject(sIdx); // <- sua função que devolve o array de tIdx da matéria
            if (!Array.isArray(order) || order.length === 0) return;

            // remove o tópico da posição atual
            const filtered = order.filter(x => x !== tIdx);

            // posição “original” é o próprio índice tIdx (ordem do edital)
            const originalPos = tIdx;

            // acha onde inserir: antes do primeiro que tem originalPos maior
            let insertAt = filtered.length;
            for (let i = 0; i < filtered.length; i++) {
                const other = filtered[i];
                if (other > originalPos) { // porque no edital o índice é a ordem original
                    insertAt = i;
                    break;
                }
            }

            filtered.splice(insertAt, 0, tIdx);

            setTopicOrderForSubject(sIdx, filtered); // <- sua função que salva a fila da matéria
        }

        // volta a fila dessa matéria para a ordem original do edital
        function resetTopicOrderToDefault(sIdx) {
            const k = topicQueueKey(sIdx);
            topicQueue[k] = getDefaultTopicOrder(sIdx);
            saveTopicQueue();
        }
        function getTopicOrderForSubject(sIdx) {
            return getTopicQueueForSubject(sIdx).slice();
        }

        function setTopicOrderForSubject(sIdx, order) {
            const def = getDefaultTopicOrder(sIdx);
            if (!Array.isArray(order) || order.length !== def.length) {
                topicQueue[topicQueueKey(sIdx)] = def;
                saveTopicQueue();
                return;
            }

            const setOrder = new Set(order);
            if (setOrder.size !== def.length || def.some(i => !setOrder.has(i))) {
                topicQueue[topicQueueKey(sIdx)] = def;
                saveTopicQueue();
                return;
            }

            topicQueue[topicQueueKey(sIdx)] = order.slice();
            saveTopicQueue();
        }

        function moveTopicUpInSubject(sIdx, tIdx) {
            const order = getTopicOrderForSubject(sIdx);
            const pos = order.indexOf(tIdx);
            if (pos <= 0) return;

            [order[pos - 1], order[pos]] = [order[pos], order[pos - 1]];
            setTopicOrderForSubject(sIdx, order);
            renderTopics();
        }

        function moveTopicDownInSubject(sIdx, tIdx) {
            const order = getTopicOrderForSubject(sIdx);
            const pos = order.indexOf(tIdx);
            if (pos === -1 || pos >= order.length - 1) return;

            [order[pos], order[pos + 1]] = [order[pos + 1], order[pos]];
            setTopicOrderForSubject(sIdx, order);
            renderTopics();
        }
        // garante que a fila é válida (tamanho e itens)
        function getTopicQueueForSubject(sIdx) {
            const k = topicQueueKey(sIdx);
            const def = getDefaultTopicOrder(sIdx);

            const q = topicQueue?.[k];
            if (!Array.isArray(q) || q.length !== def.length) {
                topicQueue[k] = def;
                saveTopicQueue();
                return def;
            }

            // valida se tem todos índices
            const setQ = new Set(q);
            if (setQ.size !== def.length) {
                topicQueue[k] = def;
                saveTopicQueue();
                return def;
            }

            return q;
        }


        function getBaseSubjectOrder() {
            // ordem fixa pelo campo s.order (1..100). Se não existir, usa 50.
            return edital
                .map((s, idx) => ({ s, idx }))
                .filter(({ s }) => !isHiddenEverywhere(s))
                .map(({ s, idx }) => ({
                    idx,
                    order: (typeof s.order === "number" && Number.isFinite(s.order)) ? s.order : 50
                }))
                .sort((a, b) => (a.order - b.order) || (a.idx - b.idx))
                .map(x => x.idx);
        }

        // -----------------------------
        // Cycle queue (round-robin)
        // -----------------------------
        let subjectQueue = null;
        try { subjectQueue = JSON.parse(localStorage.getItem('study_subject_queue_v1')) || null; }
        catch { subjectQueue = null; }

        function ensureSubjectQueue() {
            const base = getBaseSubjectOrder();
            if (!Array.isArray(subjectQueue) || subjectQueue.length !== base.length) {
                subjectQueue = base.slice();
                localStorage.setItem('study_subject_queue_v1', JSON.stringify(subjectQueue));
                return subjectQueue;
            }

            // remove inválidos e repõe faltantes mantendo ordem atual
            const setBase = new Set(base);
            subjectQueue = subjectQueue.filter(x => setBase.has(x));

            const setQ = new Set(subjectQueue);
            base.forEach(x => { if (!setQ.has(x)) subjectQueue.push(x); });

            // se ainda desalinhou, normaliza
            if (subjectQueue.length !== base.length) subjectQueue = base.slice();

            localStorage.setItem('study_subject_queue_v1', JSON.stringify(subjectQueue));
            return subjectQueue;
        }

        function saveSubjectQueue() {
            localStorage.setItem('study_subject_queue_v1', JSON.stringify(subjectQueue || []));
        }

        function moveSubjectToEnd(sIdx) {
            if (sIdx === null || sIdx === undefined) return;
            ensureSubjectQueue();
            const i = subjectQueue.indexOf(sIdx);
            if (i >= 0) subjectQueue.splice(i, 1);
            subjectQueue.push(sIdx);
            saveSubjectQueue();
        }

        function restoreSubjectToBasePosition(sIdx) {
            if (sIdx === null || sIdx === undefined) return;

            const base = getBaseSubjectOrder();
            const rank = new Map(base.map((id, i) => [id, i]));

            ensureSubjectQueue();
            subjectQueue = subjectQueue.filter(x => x !== sIdx);

            const myRank = rank.get(sIdx);
            if (myRank === undefined) {
                subjectQueue.push(sIdx);
                saveSubjectQueue();
                return;
            }

            // insere antes do primeiro item que deveria vir depois na ordem base
            let insertAt = subjectQueue.length;
            for (let i = 0; i < subjectQueue.length; i++) {
                const r = rank.get(subjectQueue[i]);
                if (r !== undefined && r > myRank) { insertAt = i; break; }
            }
            subjectQueue.splice(insertAt, 0, sIdx);

            saveSubjectQueue();
        }

        function getSubjectOrderForCycle() {
            // ordem atual do ciclo (fila). Ao concluir/dominado, a matéria vai pro fim.
            return ensureSubjectQueue();
        }




