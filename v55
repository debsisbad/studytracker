        // -----------------------------
        // Rename topic
        // -----------------------------
        function renameTopicByIndex(sIdx, tIdx, newNameRaw) {
            const subject = edital?.[sIdx];
            if (!subject || !Array.isArray(subject.topicos)) return;

            const newName = String(newNameRaw || "").trim();
            if (!newName) {
                showModal("Erro", "O nome do tópico não pode ficar vazio.");
                return;
            }

            const oldName = String(subject.topicos[tIdx] || "").trim();
            if (!oldName || newName === oldName) return;

            const duplicate = subject.topicos.some((topic, index) =>
                index !== tIdx && normKey(topic) === normKey(newName)
            );

            if (duplicate) {
                showModal("Erro", "Já existe um tópico com esse nome nesta matéria.");
                return;
            }

            // O progresso continua ligado ao mesmo índice ST_sIdx_tIdx.
            // Portanto, editar o texto não apaga checks, revisões ou porcentagem.
            subject.topicos[tIdx] = newName;
            save();
            showModal("Salvo", "Nome do tópico atualizado. A alteração também será incluída no backup exportado.");
        }

        function promptRenameTopic(sIdx, tIdx) {
