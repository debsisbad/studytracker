        // -----------------------------
        // Dashboard: motor de próxima ação
        // -----------------------------
        function personalPriorityBoost(subject) {
            const priority = subject?.priority || (subject?.lowPriority ? 'secondary' : 'primary');
            return priority === 'important' ? 30 : priority === 'primary' ? 15 : 0;
        }

        function importanceBoost(subject) {
            const points = Math.max(0.1, subjectExamPoints(subject));
            return Math.min(55, Math.log2(1 + points) * 8);
        }

        function getStudyDecisionActions(limit = 4) {
            const now = Date.now();
            const endToday = new Date();
            endToday.setHours(23, 59, 59, 999);
            const startToday = new Date();
            startToday.setHours(0, 0, 0, 0);
            const byTopic = new Map();

            const add = (action) => {
                const key = `${action.sIdx}:${action.tIdx}`;
                const previous = byTopic.get(key);
                if (!previous || action.score > previous.score) byTopic.set(key, action);
            };

            getErrorNotebookItems().forEach(item => {
                if (item.done || item.dueAt > endToday.getTime()) return;
                const subject = edital[item.sIdx];
                if (!subject || isHiddenEverywhere(subject) || !activeSubjectAllowed(subject)) return;
                const overdueDays = Math.max(0, Math.floor((startToday.getTime() - item.dueAt) / 86400000));
                add({
                    kind: 'error', sIdx: item.sIdx, tIdx: item.tIdx,
                    materia: item.materia, topico: item.topico,
                    badge: overdueDays ? 'ERRO ATRASADO' : 'CADERNO DE ERROS',
                    reason: overdueDays ? `revisão do erro atrasada há ${overdueDays} dia${overdueDays === 1 ? '' : 's'}` : 'revisão do caderno de erros para hoje',
                    score: 1000 + overdueDays * 8 + personalPriorityBoost(subject) + importanceBoost(subject)
                });
            });

            edital.forEach((subject, sIdx) => {
                if (isHiddenEverywhere(subject) || !activeSubjectAllowed(subject)) return;
                subject.topicos.forEach((topic, tIdx) => {
                    const st = userProgress[`ST_${sIdx}_${tIdx}`] || {};
                    const nextReview = getNextPendingAgendaDate(st);
                    const pct = recentTopicPercent(st);
                    const boost = personalPriorityBoost(subject) + importanceBoost(subject);

                    if (nextReview && nextReview <= endToday.getTime()) {
                        const overdueDays = Math.max(0, Math.floor((startToday.getTime() - nextReview) / 86400000));
                        add({
                            kind: 'review', sIdx, tIdx, materia: subject.materia, topico: topic,
                            badge: overdueDays ? 'REVISÃO ATRASADA' : 'REVISÃO HOJE',
                            reason: overdueDays ? `revisão atrasada há ${overdueDays} dia${overdueDays === 1 ? '' : 's'}` : 'revisão programada para hoje',
                            score: 900 + overdueDays * 7 + (pct !== null ? Math.max(0, 70 - pct) * 2 : 0) + boost
                        });
                        return;
                    }

                    if (isLearningStatusEnabled('fragile') && pct !== null && pct < 70) {
                        add({
                            kind: 'fragile', sIdx, tIdx, materia: subject.materia, topico: topic,
                            badge: 'PONTO FRÁGIL',
                            reason: `${pct}% de desempenho — faça questões no TEC e registre o resultado`,
                            score: 700 + (70 - pct) * 4 + boost
                        });
                        return;
                    }

                    if (!st.q) {
                        add({
                            kind: 'new', sIdx, tIdx, materia: subject.materia, topico: topic,
                            badge: 'CONTEÚDO NOVO',
                            reason: 'ainda não estudado e elegível no ciclo atual',
                            score: 500 + boost
                        });
                        return;
                    }

                    const sessions = topicSessions(st);
                    const lastContact = Math.max(Number(st.aulaAt) || 0, Number(st.lastR) || 0, ...sessions.map(session => Number(session.at) || 0));
                    const staleDays = lastContact ? Math.floor((now - lastContact) / 86400000) : 0;
                    if (staleDays >= 14 && !effectiveProbableMastery(st)) {
                        add({
                            kind: 'stale', sIdx, tIdx, materia: subject.materia, topico: topic,
                            badge: 'RETESTAR',
                            reason: `sem contato há ${staleDays} dias — valide a retenção no TEC`,
                            score: 420 + Math.min(80, staleDays) + boost
                        });
                    }
                });
            });

            return [...byTopic.values()].sort((a, b) => b.score - a.score).slice(0, Math.max(1, limit));
        }

