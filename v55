        function ensure(k) {
            if (!userProgress[k]) {
                userProgress[k] = { q: false, countR: 0, lastR: null, dominated: false, aulaAt: null, revAt: [], pct: null, sessions: [], questionStatsOverride: null };
            } else {
                if (userProgress[k].aulaAt === undefined) userProgress[k].aulaAt = null;
                if (!Array.isArray(userProgress[k].revAt)) userProgress[k].revAt = [];
                if (userProgress[k].pct === undefined) userProgress[k].pct = null;
                if (!Array.isArray(userProgress[k].sessions)) userProgress[k].sessions = [];
                if (!userProgress[k].questionStatsOverride || typeof userProgress[k].questionStatsOverride !== 'object') userProgress[k].questionStatsOverride = null;
                // garante booleans (evita "FALSE"/"TRUE" virarem truthy)
                userProgress[k].q = (userProgress[k].q === true);
                userProgress[k].dominated = (userProgress[k].dominated === true);
            }
            if (!Array.isArray(userProgress[k].agendaDone)) {
                userProgress[k].agendaDone = Array(9).fill(false);
            } else {
                while (userProgress[k].agendaDone.length < 9) userProgress[k].agendaDone.push(false);
            }
            // PASSO 6 AQUI
            if (userProgress[k].dominated === true) userProgress[k].q = true;
        }


        function parseDateInputToTs(v) {
            const s = String(v || "").trim();
            if (!s) return null;

            // yyyy-mm-dd (bom pra input type="date")
            let m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (m) {
                const y = +m[1], mm = +m[2], d = +m[3];
                return new Date(y, mm - 1, d, 12, 0, 0, 0).getTime(); // 12h evita problemas de fuso
            }

            // dd/mm/yyyy
            m = s.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
            if (m) {
                const d = +m[1], mm = +m[2], y = +m[3];
                return new Date(y, mm - 1, d, 12, 0, 0, 0).getTime();
            }

            // fallback (se vier algo tipo "22 Feb 2026")
            const t = Date.parse(s);
            return isNaN(t) ? null : t;
        }

        function tsToInputDate(ts) {
            const t = toTs(ts);
            if (!t) return "";
            const d = new Date(t);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, "0");
            const day = String(d.getDate()).padStart(2, "0");
            return `${y}-${m}-${day}`;
        }

        function editAulaDate(storageKey) {
            ensure(storageKey);

            const oldAula = toTs(userProgress[storageKey].aulaAt);
            const defaultVal = tsToInputDate(oldAula);

            showInputModal(
                "Editar data da aula",
                "Escolha a nova data da AULA.\nAs datas planejadas das revisões (Agenda/Próximas) serão recalculadas.\nSe já houver revisões registradas, elas serão deslocadas junto.",
                defaultVal,
                (val) => {
                    const newAula = parseDateInputToTs(val);
                    if (!newAula) return;

                    const st = userProgress[storageKey];
                    const delta = (oldAula ? (newAula - oldAula) : 0);

                    st.aulaAt = newAula;

                    // desloca revisões já registradas (revAt) e lastR junto
                    if (delta && Array.isArray(st.revAt) && st.revAt.length) {
                        st.revAt = st.revAt.map(t => (typeof t === "number" ? (t + delta) : t));
                        if (st.lastR) st.lastR = toTs(st.lastR) + delta;
                    } else {
                        // se não tem revisões, garante lastR coerente (se você usa lastR)
                        if (!st.revAt || st.revAt.length === 0) st.lastR = st.lastR || newAula;
                    }

                    save();
                    renderCurrentView();
                },
                { type: "date", hint: "Dica: use o seletor de data. Também aceita dd/mm/aaaa." }
            );
        }

        window.editAulaDate = editAulaDate;


        function toggleConcluido(k) {
            ensure(k);

            const now = Date.now();
            const info = parseStorageKey(k);
            const turningOn = !userProgress[k].q;

            if (turningOn) {
                userProgress[k].q = true;

                if (!userProgress[k].aulaAt) userProgress[k].aulaAt = now;

                // O primeiro contato não é contabilizado como revisão.
                userProgress[k].countR = Math.max(userProgress[k].countR || 0, 0);
                userProgress[k].lastR = userProgress[k].aulaAt || now;

                // ao marcar concluído: manda o tópico pro fim da fila da matéria
                if (info) moveTopicToEnd(info.sIdx, info.tIdx);

                // e envia a matéria para o fim da fila do ciclo,
                // fazendo a próxima matéria aparecer no topo
                if (info) moveSubjectToEnd(info.sIdx);

                save();
                return;
            }

            // ao desmarcar concluído: zera tudo do tópico
            // ao desmarcar concluído: remove o estado por completo (fica como "nunca concluído")
            delete userProgress[k];

            // mantém suas rotinas de fila
            if (info) resetTopicOrderToDefault(info.sIdx);
            if (info) restoreSubjectToBasePosition(info.sIdx);

            save();
        }

        function toggleAgendaReview(k, i) {
            ensure(k);
            const st = userProgress[k];
            const wasDone = !!st.agendaDone[i];

            if (wasDone) {
                st.agendaDone[i] = false;
                st.countR = st.agendaDone.filter(Boolean).length;
                const sessionIndex = Array.isArray(st.sessions)
                    ? st.sessions.findIndex(raw => {
                        const session = normalizeSession(raw);
                        return session.type === 'review' && session.agendaIndex === i;
                    })
                    : -1;
                if (sessionIndex >= 0) {
                    const removed = normalizeSession(st.sessions[sessionIndex]);
                    st.sessions.splice(sessionIndex, 1);
                    const revIndex = Array.isArray(st.revAt) ? st.revAt.findIndex(ts => Number(ts) === Number(removed.at)) : -1;
                    if (revIndex >= 0) st.revAt.splice(revIndex, 1);
                    st.countR = st.agendaDone.filter(Boolean).length;
                    st.lastR = st.revAt.length ? st.revAt[st.revAt.length - 1] : (st.aulaAt || null);
                }
                save();
                return;
            }

            showSessionModal(k, 'review', (session) => {
                ensure(k);
                userProgress[k].agendaDone[i] = true;
                userProgress[k].countR = userProgress[k].agendaDone.filter(Boolean).length;
                session.agendaIndex = i;
            });
        }


