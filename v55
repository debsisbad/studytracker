        // -----------------------------
        // Stats + Chart
        // -----------------------------
        function updateStats() {
            let weightedProgress = 0, totalImportance = 0;
            edital.forEach((s, sIdx) => {
                if (isHiddenEverywhere(s)) return;
                let achieved = 0;
                s.topicos.forEach((t, tIdx) => {
                    const st = userProgress[`ST_${sIdx}_${tIdx}`];
                    if (st) {
                        if (st.q) achieved++;
                        if (st.dominated || effectiveProbableMastery(st)) achieved++;
                    }
                });
                const subjectProgress = achieved / (Math.max(s.topicos.length, 1) * 2);
                const importance = subjectExamPoints(s);
                weightedProgress += subjectProgress * importance;
                totalImportance += importance;
            });
            const gp = document.getElementById('global-percent');
            const wp = document.getElementById('weighted-performance');
            const tt = document.getElementById('total-topics');
            if (gp) gp.innerText = (totalImportance > 0 ? Math.round((weightedProgress / totalImportance) * 100) : 0) + "%";
            const performance = weightedPerformancePercent();
            if (wp) wp.innerText = performance === null ? '—' : performance + '%';
            if (tt) tt.innerText = edital.reduce((a, c) => a + (isHiddenEverywhere(c) ? 0 : c.topicos.length), 0);
        }

        function renderChart() {
            const chartEl = document.getElementById('evolutionChart');
            if (!chartEl) return;
            const ctx = chartEl.getContext('2d');

            const visibleSubjects = edital.map((s, sIdx) => ({ s, sIdx })).filter(({ s }) => !isHiddenEverywhere(s));
            const dataValues = visibleSubjects.map(({ s, sIdx }) => {
                let d = 0;
                s.topicos.forEach((t, tIdx) => {
                    const st = userProgress[`ST_${sIdx}_${tIdx}`];
                    if (st) {
                        if (st.q) d++;
                        if (st.dominated || effectiveProbableMastery(st)) d++;
                    }
                });
                return Math.round((d / (Math.max(s.topicos.length, 1) * 2)) * 100);
            });

            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: visibleSubjects.map(({ s }) => s.materia),
                    datasets: [{ data: dataValues, backgroundColor: isDarkMode ? '#818cf8' : '#6366f1', borderRadius: 6 }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
