        function toTs(v) {
            if (!v) return null;
            if (typeof v === 'number') return v;
            if (typeof v === 'string') {
                const t = Date.parse(v);
                return isNaN(t) ? null : t;
            }
            return null;
        }

        function fmtTs(ts) {
            const t = toTs(ts);
            return t ? new Date(t).toLocaleDateString('pt-pt') : '-';
        }

        function addDays(ts, days) {
            const t = toTs(ts);
            if (!t) return null;
            const d = new Date(t);
            d.setDate(d.getDate() + days);
            return d.getTime();
        }

        function getAgendaReviewDays(isDominated = false) {
            if (learningConfig.mode === 'final') {
                // Na reta final os testes ativos são flexíveis; a grade serve como marcos de acompanhamento.
                return isDominated
                    ? [null, null, null, null, 14, 28, 42, 56, 70]
                    : [7, 14, 21, 28, 35, 42, 49, 56, 63];
            }
            if (isDominated) return [null, null, null, null, 50, 100, 150, 200, 250];
            // Livro: cinco revisões com 25 dias de espaçamento; depois manutenção a cada 50 dias.
            return [25, 50, 75, 100, 125, 175, 225, 275, 325];
        }

        function getAgendaVisibleIndexes() {
            // página 1: 1ª, 2ª, 3ª, 4ª, 5ª
            // página 2: 5ª, 6ª, 7ª, 8ª, 9ª
            return agendaReviewPage === 0 ? [0, 1, 2, 3, 4] : [4, 5, 6, 7, 8];
