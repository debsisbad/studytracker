        function saveSubjectOrderFromUI() {
            const box = document.getElementById("settings-order-list");
            if (!box) return;

            const inputs = box.querySelectorAll("input[data-subject-index]");
            const weightInputs = box.querySelectorAll("input[data-subject-weight-index]");
            const questionInputs = box.querySelectorAll("input[data-subject-questions-index]");
            const used = new Map(); // número -> idx (pra detectar duplicados)

            for (const inp of inputs) {
                const idx = Number(inp.getAttribute("data-subject-index"));
                const raw = Number(String(inp.value).trim());

                if (!Number.isFinite(raw) || raw < 1 || raw > 100) {
                    showModal("Erro", "Use apenas números de 1 a 100 para a ordem.");
                    return;
                }

                const v = Math.round(raw);

                // (opcional) impedir duplicados
                if (used.has(v)) {
                    const otherIdx = used.get(v);
                    showModal("Erro", `Ordem repetida: ${v}\n\n"${edital[otherIdx].materia}" e "${edital[idx].materia}" estão com o mesmo número.`);
                    return;
                }
                used.set(v, idx);

                edital[idx].order = v;
            }

            for (const inp of weightInputs) {
                const idx = Number(inp.getAttribute("data-subject-weight-index"));
                const rawText = String(inp.value).trim().replace(',', '.');
                const weight = Number(rawText);
                if (!Number.isFinite(weight) || weight < 0.1 || weight > 10) {
                    showModal("Erro", "Use pesos entre 0,1 e 10.");
                    return;
                }
                edital[idx].weight = Math.round(weight * 10) / 10;
            }

            for (const inp of questionInputs) {
                const idx = Number(inp.getAttribute("data-subject-questions-index"));
                const questions = Number(String(inp.value).trim());
                if (!Number.isFinite(questions) || questions < 0 || questions > 200 || !Number.isInteger(questions)) {
                    showModal("Erro", "Use números inteiros entre 0 e 200 para a quantidade de questões.");
                    return;
                }
                edital[idx].examQuestions = questions;
            }

            save();
            showModal("Ok", "Ordem e pesos das matérias salvos.");
            renderSubjectOrderSettings(); // reordena a lista dentro das configs
        }

