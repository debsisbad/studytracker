        function effectiveSubjectWeight(subject) {
            if (learningConfig.useSubjectWeights === false) return 1;
            return Math.max(0.1, Math.min(10, Number(subject?.weight) || 1));
        }

        function subjectExamQuestions(subject) {
            const value = Number(subject?.examQuestions);
            return Number.isFinite(value) && value > 0 ? Math.round(value) : 0;
        }

        function subjectExamPoints(subject) {
            const questions = subjectExamQuestions(subject);
            const weight = effectiveSubjectWeight(subject);
            return questions > 0 ? questions * weight : weight;
        }

        function buildWeightedCycleOrder(subjectIndexes) {
            if (!subjectIndexes.length) return [];
            const raw = subjectIndexes.map(sIdx => Math.max(0.1, subjectExamPoints(edital[sIdx])));
            const minimum = Math.min(...raw);
            const counts = raw.map(value => Math.max(1, Math.min(12, Math.round(value / minimum))));
            const total = counts.reduce((sum, value) => sum + value, 0);
            const current = counts.map(() => 0);
            const result = [];

            for (let slot = 0; slot < total; slot++) {
                let selected = 0;
                for (let i = 0; i < counts.length; i++) {
                    current[i] += counts[i];
                    if (current[i] > current[selected]) selected = i;
                }
                current[selected] -= total;
                result.push(subjectIndexes[selected]);
            }
            return result;
        }

        function weightedPerformancePercent(since = null) {
            let weightedAccuracy = 0;
            let totalImportance = 0;

            edital.forEach((subject, sIdx) => {
                if (isHiddenEverywhere(subject)) return;
                const sessions = subject.topicos.flatMap((_, tIdx) => topicSessions(userProgress[`ST_${sIdx}_${tIdx}`]))
                    .filter(session => session.questions > 0 && (!since || session.at >= since));
                const questions = sessions.reduce((sum, session) => sum + session.questions, 0);
                if (!questions) return;
                const correct = sessions.reduce((sum, session) => sum + session.correct, 0);
                const importance = subjectExamPoints(subject);
                weightedAccuracy += (correct / questions) * importance;
                totalImportance += importance;
            });

            return totalImportance ? Math.round((weightedAccuracy / totalImportance) * 100) : null;
        }

        function getSubjectRiskAlerts() {
            const now = Date.now();
            const staleLimit = now - 14 * 86400000;
            const alerts = [];

            edital.forEach((subject, sIdx) => {
                if (isHiddenEverywhere(subject) || !activeSubjectAllowed(subject)) return;
                const sessions = subject.topicos.flatMap((_, tIdx) => topicSessions(userProgress[`ST_${sIdx}_${tIdx}`]));
                const scored = sessions.filter(session => session.questions > 0);
                const questions = scored.reduce((sum, session) => sum + session.questions, 0);
                const correct = scored.reduce((sum, session) => sum + session.correct, 0);
                const lastContact = subject.topicos.reduce((latest, _, tIdx) => {
                    const st = userProgress[`ST_${sIdx}_${tIdx}`] || {};
                    const sessionAt = topicSessions(st).reduce((value, session) => Math.max(value, session.at), 0);
                    return Math.max(latest, Number(st.aulaAt) || 0, Number(st.lastR) || 0, sessionAt);
                }, 0);
                const reasons = [];
                if (!questions) reasons.push('sem questões registradas');
                else if (isLearningStatusEnabled('fragile') && (correct / questions) * 100 < 60) reasons.push('acertos abaixo de 60%');
                if (scored.length > 0 && scored.length < 3) reasons.push('menos de 3 testes');
                if (!lastContact || lastContact < staleLimit) reasons.push('sem estudo nos últimos 14 dias');
                if (reasons.length) alerts.push({ materia: subject.materia, reasons, points: subjectExamPoints(subject) });
            });

            return alerts.sort((a, b) => b.points - a.points || a.materia.localeCompare(b.materia, 'pt-BR'));
        }

