        function getMobileCycleItems(limit = 30) {
            const subjectOrder = getSubjectOrderForCycle()
                .filter(sIdx => !isHiddenInCycle(edital[sIdx]))
                .filter(sIdx => subjectHasCycleTag(edital[sIdx], cycleTagFilter));
            const expanded = buildWeightedCycleOrder(subjectOrder);
            const pointers = {};
            const orderedTopics = {};
            expanded.forEach(sIdx => {
                if (orderedTopics[sIdx]) return;
                let order = getTopicQueueForSubject(sIdx).slice();
                order.sort((a,b) => {
                    if (learningConfig.mode !== 'final' || !isLearningStatusEnabled('fragile')) return 0;
                    const pa = recentTopicPercent(userProgress[`ST_${sIdx}_${a}`]);
                    const pb = recentTopicPercent(userProgress[`ST_${sIdx}_${b}`]);
                    const wa = pa === null ? 101 : pa;
                    const wb = pb === null ? 101 : pb;
                    return (wa - wb) || (a - b);
                });
                orderedTopics[sIdx] = order;
                pointers[sIdx] = 0;
            });
            const out = [];
            let guard = 0;
            while (out.length < limit && guard++ < 500) {
                let added = false;
                for (const sIdx of expanded) {
                    const order = orderedTopics[sIdx] || [];
                    while (pointers[sIdx] < order.length) {
                        const tIdx = order[pointers[sIdx]++];
                        const st = userProgress[`ST_${sIdx}_${tIdx}`];
                        if (hideDoneTopicsInCycle && st?.q === true) continue;
                        out.push({sIdx,tIdx,materia:edital[sIdx].materia,topico:edital[sIdx].topicos[tIdx]});
                        added = true;
                        break;
                    }
                    if (out.length >= limit) break;
                }
                if (!added) break;
            }
            return out;
        }

