        // -----------------------------
        // Backup / Import (XLSX)
        // -----------------------------
        function makeProgressKey(materia, topico) {
            return `${normKey(materia)}||${normKey(topico)}`;
        }

        // ✅ pega coluna mesmo se vier com nomes diferentes / maiúsculas / acento
        function getAnyCell(row, candidates) {
            if (!row) return undefined;
            for (const c of candidates) {
                if (row[c] !== undefined) return row[c];
            }
            const keys = Object.keys(row);
            const candNorm = candidates.map(x => normKey(x));
            for (const k of keys) {
                const nk = normKey(k);
                const idx = candNorm.indexOf(nk);
                if (idx !== -1) return row[k];
            }
            return undefined;
        }

        function applyRowsToEdital(rows) {
            const oldEdital = Array.isArray(edital) ? edital : [];
            const oldProgress = userProgress || {};

            // debug: ajuda a ver se a import trouxe as colunas certas
            try {
                console.log("IMPORT rows:", Array.isArray(rows) ? rows.length : rows);
                console.log("IMPORT colunas:", rows?.[0] ? Object.keys(rows[0]) : []);
                console.log("IMPORT 1a linha:", rows?.[0]);
            } catch { }

            const oldMap = new Map();
            oldEdital.forEach((s, sIdx) => {
                (s.topicos || []).forEach((t, tIdx) => {
                    const k = `ST_${sIdx}_${tIdx}`;
                    const st = oldProgress[k];
                    if (st) oldMap.set(makeProgressKey(s.materia, t), st);
                });
            });

            const oldSubjectsMap = new Map();
            oldEdital.forEach(s => oldSubjectsMap.set(normKey(s.materia), s));

            function parseTagsCell(v) {
                const s = (v ?? "").toString().trim();
                if (!s) return [];
                return s.split(",").map(x => x.trim()).filter(Boolean);
            }

            // ✅ SEMPRE existe (mesmo que não seja backup)
            const fileProgressMap = new Map();

            const looksLikeBackup = Array.isArray(rows) && rows.some(r =>
                ("COUNT_R" in r) || ("CONCLUIDO" in r) || ("DOMINADO" in r) || ("REV_AT" in r) || ("AULA_AT" in r) || ("PCT" in r) ||
                ("AGENDA_DONE" in r) || ("REVISAO_1_FEITA" in r) || ("REVISÃO_1_FEITA" in r) ||
                ("count_r" in r) || ("concluido" in r) || ("dominado" in r) || ("agenda_done" in r)
            );

            if (looksLikeBackup) {
                const first = rows[0] || {};
                const importedMode = String(getAnyCell(first, ['STUDY_MODE', 'MODO_ESTUDO']) || '').trim();
                if (importedMode === 'long' || importedMode === 'final') learningConfig.mode = importedMode;
                const importedExam = String(getAnyCell(first, ['EXAM_DATE', 'DATA_PROVA']) || '').trim();
                if (importedExam) learningConfig.examDate = importedExam;
                const importedTag = String(getAnyCell(first, ['ACTIVE_TAG', 'TAG_ATIVA']) || '').trim();
                if (importedTag) learningConfig.activeTag = importedTag;
                const importedTarget = Number(getAnyCell(first, ['MASTERY_TARGET', 'META_DOMINIO']));
                if (Number.isFinite(importedTarget)) learningConfig.masteryTarget = Math.max(60, Math.min(100, importedTarget));
                const importedUseWeights = getAnyCell(first, ['USE_SUBJECT_WEIGHTS', 'USAR_PESOS_MATERIAS', 'PESOS_ATIVOS']);
                if (importedUseWeights !== undefined && importedUseWeights !== '') learningConfig.useSubjectWeights = parseBool(importedUseWeights);
                const importedStatusFragile = getAnyCell(first, ['STATUS_FRAGILE_ENABLED', 'STATUS_FRAGIL_ATIVO', 'FRAGIL_ATIVO']);
                const importedStatusBuilding = getAnyCell(first, ['STATUS_BUILDING_ENABLED', 'STATUS_CONSOLIDANDO_ATIVO', 'CONSOLIDANDO_ATIVO']);
                const importedStatusStrong = getAnyCell(first, ['STATUS_STRONG_ENABLED', 'STATUS_FORTE_ATIVO', 'FORTE_ATIVO']);
                const importedStatusSeen = getAnyCell(first, ['STATUS_SEEN_ENABLED', 'STATUS_VISTO_ATIVO', 'VISTO_ATIVO']);
                if (importedStatusFragile !== undefined && importedStatusFragile !== '') learningConfig.statusFragileEnabled = parseBool(importedStatusFragile);
                if (importedStatusBuilding !== undefined && importedStatusBuilding !== '') learningConfig.statusBuildingEnabled = parseBool(importedStatusBuilding);
                if (importedStatusStrong !== undefined && importedStatusStrong !== '') learningConfig.statusStrongEnabled = parseBool(importedStatusStrong);
                if (importedStatusSeen !== undefined && importedStatusSeen !== '') learningConfig.statusSeenEnabled = parseBool(importedStatusSeen);
                saveLearningConfig();
                rows.forEach(r => {
                    const materia = (getAnyCell(r, ["MATERIA", "MATÉRIA", "Materia", "Matéria"]) ?? "").toString().trim();
                    const topico = (
                        (getAnyCell(r, ["SUBTOPICO", "SUBTÓPICO", "Subtopico", "Subtópico", "SUBT"]) ?? "").toString().trim() ||
                        (getAnyCell(r, ["TOPICO", "TÓPICO", "Topico", "Tópico"]) ?? "").toString().trim()
                    );

                    if (!materia || !topico) return;

                    const key = makeProgressKey(materia, topico);

                    fileProgressMap.set(key, {
                        q: parseBool(getAnyCell(r, ["CONCLUIDO", "CONCLUÍDO", "Concluido", "Concluído"])),
                        dominated: parseBool(getAnyCell(r, ["DOMINADO", "Dominado"])),
                        countR: Number(getAnyCell(r, ["COUNT_R", "count_r", "CountR", "COUNT"]) ?? 0) || 0,
                        lastR: parseDateAny(getAnyCell(r, ["LAST_R", "last_r", "ULTIMA_REV", "ÚLTIMA_REV", "ULTIMA_REVISÃO"])),
                        aulaAt: parseDateAny(getAnyCell(r, ["AULA_AT", "aula_at", "AULA", "DATA_AULA"])),
                        revAt: parseRevAt(getAnyCell(r, ["REV_AT", "rev_at", "REVISOES", "REVISÕES"])),
                        pct: parsePct(getAnyCell(r, ["PCT", "PORCENTAGEM", "PERCENTUAL", "%", "PROGRESSO"])),
                        agendaDone: parseAgendaDoneRow(r),
                        sessions: parseJsonArray(getAnyCell(r, ['SESSIONS', 'SESSION_HISTORY', 'SESSOES'])).map(normalizeSession),
                        questionStatsOverride: (() => {
                            const questions = Number(getAnyCell(r, ['TOPIC_QUESTIONS', 'QUESTOES_TOPICO', 'QUESTÕES_TÓPICO']));
                            const correct = Number(getAnyCell(r, ['TOPIC_CORRECT', 'ACERTOS_TOPICO', 'ACERTOS_TÓPICO']));
                            return Number.isFinite(questions) && questions >= 0 && Number.isFinite(correct) && correct >= 0
                                ? { questions: Math.round(questions), correct: Math.min(Math.round(questions), Math.round(correct)) }
                                : null;
                        })()
                    });
                });
            }

            const subjects = new Map();

            rows.forEach(r => {
                const materia = (getAnyCell(r, ["MATERIA", "MATÉRIA", "Materia", "Matéria"]) ?? "").toString().trim();

                const topico = (getAnyCell(r, ["TOPICO", "TÓPICO", "Topico", "Tópico"]) ?? "").toString().trim();
                const sub = (getAnyCell(r, ["SUBTOPICO", "SUBTÓPICO", "Subtopico", "Subtópico", "SUBT"]) ?? "").toString().trim();

                const tagsFromFile =
                    parseTagsCell(getAnyCell(r, ["TAGS", "TAGS_MATERIA", "TAGS DA MATERIA", "ETIQUETAS"])) ||
                    parseTagsCell(getAnyCell(r, ["TAGS_MATERIA"]));
                const priorityFromFile = String(getAnyCell(r, ['PRIORITY', 'PRIORIDADE']) || '').trim().toLowerCase();
                const weightFromFile = Number(String(getAnyCell(r, ['SUBJECT_WEIGHT', 'PESO_MATERIA', 'PESO']) ?? '').replace(',', '.'));
                const questionsFromFile = Number(getAnyCell(r, ['EXAM_QUESTIONS', 'QUESTOES_PROVA', 'QUESTÕES_PROVA', 'NUMERO_QUESTOES']));
                const orderFromFile = Number(getAnyCell(r, ['SUBJECT_ORDER', 'ORDEM_MATERIA']));
                const hiddenCycleFromFile = getAnyCell(r, ['HIDDEN_CYCLE', 'OCULTA_CICLO']);
                const hiddenAgendaFromFile = getAnyCell(r, ['HIDDEN_AGENDA', 'OCULTA_AGENDA']);
                const hiddenEverywhereFromFile = getAnyCell(r, ['HIDDEN_EVERYWHERE', 'OCULTA_TUDO', 'OCULTAR_DE_TUDO']);

                if (!materia) return;

                if (!subjects.has(materia)) {
                    const prev = oldSubjectsMap.get(normKey(materia));
                    subjects.set(materia, {
                        materia,
                        lowPriority: prev ? !!prev.lowPriority : false,
                        priority: ['important', 'primary', 'secondary'].includes(priorityFromFile) ? priorityFromFile : (prev?.priority || (prev?.lowPriority ? 'secondary' : 'primary')),
                        weight: Number.isFinite(weightFromFile) && weightFromFile > 0 ? weightFromFile : (Number(prev?.weight) > 0 ? Number(prev.weight) : 1),
                        examQuestions: Number.isFinite(questionsFromFile) && questionsFromFile >= 0 ? Math.round(questionsFromFile) : (Number(prev?.examQuestions) >= 0 ? Math.round(Number(prev.examQuestions)) : 0),
                        order: Number.isFinite(orderFromFile) && orderFromFile > 0 ? orderFromFile : (Number.isFinite(prev?.order) ? prev.order : subjects.size + 1),
                        hiddenInCycle: hiddenCycleFromFile !== undefined ? parseBool(hiddenCycleFromFile) : prev?.hiddenInCycle === true,
                        hiddenInAgenda: hiddenAgendaFromFile !== undefined ? parseBool(hiddenAgendaFromFile) : prev?.hiddenInAgenda === true,
                        hiddenEverywhere: hiddenEverywhereFromFile !== undefined ? parseBool(hiddenEverywhereFromFile) : prev?.hiddenEverywhere === true,
                        tags: (tagsFromFile && tagsFromFile.length)
                            ? normalizeTagsList(tagsFromFile)
                            : (prev ? (normalizeTagsList(prev.tags || [])) : []),
                        topicos: []
                    });
                } else {
                    const s0 = subjects.get(materia);
                    if ((!s0.tags || s0.tags.length === 0) && tagsFromFile && tagsFromFile.length) {
                        s0.tags = normalizeTagsList(tagsFromFile);
                    }
                }

                const s = subjects.get(materia);

                if (topico && !s.topicos.includes(topico)) s.topicos.push(topico);
                if (sub && !s.topicos.includes(sub)) s.topicos.push(sub);
            });

            const newEdital = Array.from(subjects.values());
            const newProgress = {};

            newEdital.forEach((s, sIdx) => {
                (s.topicos || []).forEach((t, tIdx) => {
                    const newKey = `ST_${sIdx}_${tIdx}`;
                    const k = makeProgressKey(s.materia, t);

                    const fromFile = fileProgressMap.get(k);
                    const fromOld = oldMap.get(k);

                    const base = fromFile || fromOld || null;
                    const agendaFromFile = Array.isArray(fromFile?.agendaDone) ? fromFile.agendaDone : null;
                    const agendaFromOld = Array.isArray(fromOld?.agendaDone) ? fromOld.agendaDone : null;
                    const agendaDone = normalizeAgendaDone(agendaFromFile || agendaFromOld || []);

                    newProgress[newKey] = base ? {
                        q: !!base.q,
                        dominated: !!base.dominated,
                        countR: Number(base.countR ?? 0) || 0,
                        lastR: base.lastR || null,
                        aulaAt: base.aulaAt || null,
                        revAt: Array.isArray(base.revAt) ? base.revAt : [],
                        pct: (base.pct === null || base.pct === undefined) ? null : base.pct,
                        agendaDone,
                        sessions: Array.isArray(base.sessions) ? base.sessions.map(normalizeSession) : [],
                        questionStatsOverride: base.questionStatsOverride && typeof base.questionStatsOverride === 'object'
                            ? { ...base.questionStatsOverride }
                            : null
                    } : {
                        q: false,
                        dominated: false,
                        countR: 0,
                        lastR: null,
                        aulaAt: null,
                        revAt: [],
                        pct: null,
                        agendaDone: Array(9).fill(false),
                        sessions: [],
                        questionStatsOverride: null
                    };
                });
            });

            edital = newEdital;
            userProgress = newProgress;

            // ✅ garante que currentSubject aponta pra uma matéria que existe
            if (!edital.length) {
                currentSubject = "";
            } else {
                const exists = edital.some(s => s.materia === currentSubject);
                if (!exists) currentSubject = edital[0].materia;
            }

            save();
            showModal("Importado", looksLikeBackup
                ? "Backup importado (edital + progresso)."
                : "Arquivo aplicado ao edital (progresso preservado quando os tópicos batem)."
            );

        }

        async function importWithPicker() {
            if (window.studyIO?.pickAndReadAny) {
                const res = await window.studyIO.pickAndReadAny();
                if (!res || !res.ok) {
                    if (res && (res.canceled || res.error === "Cancelado")) return;
                    showModal("Erro", (res && res.error) ? res.error : "Não consegui abrir o arquivo.");
                    return;
                }
                applyRowsToEdital(res.rows || []);
                return;
            }

            // Navegador/celular: XLSX funciona sem Electron.
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.xlsx,.xls';
            input.onchange = async () => {
                const file = input.files?.[0];
                if (!file) return;
                try {
                    const buffer = await file.arrayBuffer();
                    const wb = XLSX.read(buffer, { type: 'array' });
                    const firstSheet = wb.Sheets[wb.SheetNames[0]];
                    const rows = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });
                    applyRowsToEdital(rows);
                } catch (err) {
                    console.error(err);
                    showModal('Erro', 'Não consegui importar esse XLSX no navegador.');
                }
            };
            input.click();
        }

        async function exportToXLSX() {
            try {
                const out = [];

                function findParentInSubject(subject, itemText) {
                    const match = itemText.match(/^(\d+)(\.\d+)+/);
                    if (!match) return null;
                    const parts = match[0].split('.');
                    if (parts.length <= 1) return null;
                    const parentPrefix = parts.slice(0, -1).join('.') + ".";
                    const found = subject.topicos.find(p => p.startsWith(parentPrefix + " ") || p === parentPrefix);
                    return found && found !== itemText ? found : null;
                }

                edital.forEach((s, sIdx) => {
                    s.topicos.forEach((t, tIdx) => {
                        const storageKey = `ST_${sIdx}_${tIdx}`;
                        const st = userProgress[storageKey] || {};
                        const parent = findParentInSubject(s, t);
                        const isSub = !!parent;

                        const agendaDone = normalizeAgendaDone(st.agendaDone);

                        out.push({
                            MATERIA: s.materia,
                            TAGS: (s.tags || []).join(', '),
                            PRIORITY: s.priority || 'primary',
                            SUBJECT_WEIGHT: Math.max(0.1, Number(s.weight) || 1),
                            EXAM_QUESTIONS: Math.max(0, Math.round(Number(s.examQuestions) || 0)),
                            EXAM_POINTS: subjectExamPoints(s),
                            SUBJECT_ORDER: s.order || '',
                            HIDDEN_CYCLE: s.hiddenInCycle ? 'TRUE' : 'FALSE',
                            HIDDEN_AGENDA: s.hiddenInAgenda ? 'TRUE' : 'FALSE',
                            HIDDEN_EVERYWHERE: s.hiddenEverywhere ? 'TRUE' : 'FALSE',
                            TOPICO: isSub ? parent : t,
                            SUBTOPICO: isSub ? t : '',
                            PCT: (st.pct === null || st.pct === undefined) ? '' : st.pct,
                            CONCLUIDO: st.q ? 'TRUE' : 'FALSE',
                            DOMINADO: st.dominated ? 'TRUE' : 'FALSE',
                            COUNT_R: st.countR || 0,
                            AULA_AT: st.aulaAt ? toTs(st.aulaAt) : '',
                            LAST_R: st.lastR ? toTs(st.lastR) : '',
                            REV_AT: JSON.stringify(Array.isArray(st.revAt) ? st.revAt : []),
                            SESSIONS: JSON.stringify(Array.isArray(st.sessions) ? st.sessions : []),
                            TOPIC_QUESTIONS: topicQuestionTotals(st).questions,
                            TOPIC_CORRECT: topicQuestionTotals(st).correct,
                            STUDY_MODE: learningConfig.mode,
                            EXAM_DATE: learningConfig.examDate || '',
                            ACTIVE_TAG: learningConfig.activeTag || '',
                            MASTERY_TARGET: learningConfig.masteryTarget || 80,
                            USE_SUBJECT_WEIGHTS: learningConfig.useSubjectWeights === false ? 'FALSE' : 'TRUE',
                            STATUS_FRAGILE_ENABLED: learningConfig.statusFragileEnabled === false ? 'FALSE' : 'TRUE',
                            STATUS_BUILDING_ENABLED: learningConfig.statusBuildingEnabled === false ? 'FALSE' : 'TRUE',
                            STATUS_STRONG_ENABLED: learningConfig.statusStrongEnabled === false ? 'FALSE' : 'TRUE',
                            STATUS_SEEN_ENABLED: learningConfig.statusSeenEnabled === false ? 'FALSE' : 'TRUE',
                            AGENDA_DONE: JSON.stringify(agendaDone),
                            REVISAO_1_FEITA: agendaDone[0] ? 'TRUE' : 'FALSE',
                            REVISAO_2_FEITA: agendaDone[1] ? 'TRUE' : 'FALSE',
                            REVISAO_3_FEITA: agendaDone[2] ? 'TRUE' : 'FALSE',
                            REVISAO_4_FEITA: agendaDone[3] ? 'TRUE' : 'FALSE',
                            REVISAO_5_FEITA: agendaDone[4] ? 'TRUE' : 'FALSE',
                            REVISAO_6_FEITA: agendaDone[5] ? 'TRUE' : 'FALSE',
                            REVISAO_7_FEITA: agendaDone[6] ? 'TRUE' : 'FALSE',
                            REVISAO_8_FEITA: agendaDone[7] ? 'TRUE' : 'FALSE',
                            REVISAO_9_FEITA: agendaDone[8] ? 'TRUE' : 'FALSE'
                        });
                    });
                });

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.json_to_sheet(out);
                XLSX.utils.book_append_sheet(wb, ws, 'Materias');

                const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
                const bytes = new Uint8Array(wbout);

                const name = makeBackupName();
                if (window.studyIO?.saveBackupXlsx) {
                    const res = await window.studyIO.saveBackupXlsx(Array.from(bytes), name);
                    if (!res || !res.ok) {
                        showModal("Erro", "Falha ao salvar backup: " + ((res && res.error) || ''));
                        return;
                    }
                    showModal("Backup salvo", `Salvo em:\n${res.path}`);
                } else {
                    // Navegador/celular: dispara o download pelo próprio browser.
                    XLSX.writeFile(wb, name);
                    showModal('Backup gerado', 'O arquivo XLSX foi enviado para os downloads do navegador.');
                }
            } catch (err) {
                console.error(err);
                showModal("Erro", "Falha ao exportar a planilha (.xlsx).");
            }
        }

        function editTopicQuestionTotals(k) {
            ensure(k);
            const totals = topicQuestionTotals(userProgress[k]);
            const info = parseStorageKey(k);
            const subject = info ? edital[info.sIdx] : null;
            const topic = subject?.topicos?.[info.tIdx] || '';
            const modal = document.getElementById('custom-modal');
            const title = document.getElementById('modal-title');
            const message = document.getElementById('modal-message');
            const footer = document.getElementById('modal-footer');
            if (!modal || !title || !message || !footer) return;

            title.innerText = 'Questões do tópico';
            message.innerHTML = `
            <div class="space-y-4">
              <div class="p-3 rounded-xl bg-indigo-50 dark:bg-indigo-900/30">
                <div class="text-[10px] font-bold uppercase text-indigo-500">${escapeHtml(subject?.materia || '')}</div>
                <div class="text-sm font-semibold text-gray-800 dark:text-slate-100">${escapeHtml(topic)}</div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <label class="text-xs font-bold text-gray-600 dark:text-slate-300">Questões totais
                  <input id="topic-total-questions" type="number" min="0" value="${totals.questions}" class="mt-1 w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-950 border dark:border-gray-700 text-sm" />
                </label>
                <label class="text-xs font-bold text-gray-600 dark:text-slate-300">Acertos totais
                  <input id="topic-total-correct" type="number" min="0" value="${totals.correct}" class="mt-1 w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-950 border dark:border-gray-700 text-sm" />
                </label>
              </div>
              <p class="text-xs text-gray-500 dark:text-slate-400">A tag será recalculada pelo percentual de acertos. A partir de 80%, o tópico ficará Forte; entre 70% e 79%, Consolidando; abaixo de 70%, Frágil.</p>
            </div>`;

            footer.innerHTML = '';
            if (totals.manual) {
                const automatic = document.createElement('button');
                automatic.type = 'button'; automatic.innerText = 'Usar histórico';
                automatic.className = 'px-4 py-2 rounded-xl text-sm font-semibold bg-gray-100 text-gray-700';
                automatic.onclick = () => {
                    userProgress[k].questionStatsOverride = null;
                    userProgress[k].pct = recentTopicPercent(userProgress[k]);
                    modal.style.display = 'none';
                    save();
                };
                footer.appendChild(automatic);
            }
            const cancel = document.createElement('button');
            cancel.type = 'button'; cancel.innerText = 'Cancelar';
            cancel.className = 'px-4 py-2 rounded-xl text-sm font-semibold bg-gray-100 text-gray-700';
            cancel.onclick = () => { modal.style.display = 'none'; };
            const confirm = document.createElement('button');
            confirm.type = 'button'; confirm.innerText = 'Salvar';
            confirm.className = 'px-5 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white';
            confirm.onclick = () => {
                const questions = Math.max(0, Math.round(Number(document.getElementById('topic-total-questions')?.value) || 0));
                const correct = Math.max(0, Math.round(Number(document.getElementById('topic-total-correct')?.value) || 0));
                if (correct > questions) { showModal('Erro', 'Os acertos não podem ser maiores que o total de questões.'); return; }
                userProgress[k].questionStatsOverride = { questions, correct };
                userProgress[k].pct = questions ? Math.round((correct / questions) * 100) : null;
                userProgress[k].dominated = questions > 0 && userProgress[k].pct >= (Number(learningConfig.masteryTarget) || 80);
                modal.style.display = 'none';
                save();
            };
            footer.append(cancel, confirm);
            modal.style.display = 'flex';
        }


        function normalizeAgendaDone(value) {
            const source = Array.isArray(value) ? value : [];
            return Array.from({ length: 9 }, (_, i) => source[i] === true || parseBool(source[i]));
        }

        function parseAgendaDoneRow(row) {
            const jsonValue = getAnyCell(row, ["AGENDA_DONE", "agenda_done", "AGENDA", "CHECKS_AGENDA"]);

            if (Array.isArray(jsonValue)) return normalizeAgendaDone(jsonValue);

            const jsonText = String(jsonValue ?? "").trim();
            if (jsonText) {
                try {
                    const parsed = JSON.parse(jsonText);
                    if (Array.isArray(parsed)) return normalizeAgendaDone(parsed);
                } catch { }
            }

            const values = [];
            let foundNumberedColumn = false;

            for (let i = 1; i <= 9; i++) {
                const value = getAnyCell(row, [
                    `REVISAO_${i}_FEITA`,
                    `REVISÃO_${i}_FEITA`,
                    `AGENDA_${i}`,
                    `REV_${i}_FEITA`
                ]);

                if (value !== undefined && value !== null && String(value).trim() !== "") {
                    foundNumberedColumn = true;
                }
                values.push(parseBool(value));
            }

            return foundNumberedColumn ? normalizeAgendaDone(values) : undefined;
        }

        function parsePct(v) {
            if (v === null || v === undefined) return null;
            const s = String(v).trim();
            if (!s) return null;

            const num = Number(s.replace(",", ".").replace("%", "").trim());
            if (!Number.isFinite(num)) return null;

            const clamped = Math.max(0, Math.min(100, num));
            return Math.round(clamped);
        }

        function parseBool(v) {
            if (typeof v === "boolean") return v;
            const s = String(v ?? "").trim().toLowerCase();
            return s === "true" || s === "1" || s === "sim" || s === "yes";
        }

        function parseDateAny(v) {
            if (v === null || v === undefined || v === "") return null;
            if (typeof v === "number") return v;

            const s = String(v).trim();
            if (!s) return null;

            const t = Date.parse(s);
            if (!Number.isNaN(t)) return t;

            const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
            if (m) {
                const dd = Number(m[1]), mm = Number(m[2]), yyyy = Number(m[3]);
                const d = new Date(yyyy, mm - 1, dd);
                return d.getTime();
            }

            return null;
        }

        function parseRevAt(v) {
            if (Array.isArray(v)) return v;
            const s = String(v ?? "").trim();
            if (!s) return [];
            try {
                const arr = JSON.parse(s);
                return Array.isArray(arr) ? arr : [];
            } catch {
                return [];
            }
        }

        function parseJsonArray(v) {
            if (Array.isArray(v)) return v;
            const s = String(v ?? '').trim();
            if (!s) return [];
            try { const parsed = JSON.parse(s); return Array.isArray(parsed) ? parsed : []; }
            catch { return []; }
        }

        function parseJsonObject(v) {
            if (v && typeof v === 'object' && !Array.isArray(v)) return v;
            const s = String(v ?? '').trim();
            if (!s) return null;
            try { const parsed = JSON.parse(s); return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : null; }
            catch { return null; }
        }

        // -----------------------------
        // Small safe escaping
        // -----------------------------
        function escapeHtml(str) {
            return String(str)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }
        function escapeHtmlAttr(str) { return escapeHtml(str).replaceAll("\n", " "); }

        // ----------------------------------------------------
        // Expor funções no window
        // ----------------------------------------------------
        window.promptRenameSubject = promptRenameSubject;
        window.renameSubjectByIndex = renameSubjectByIndex;

        window.editSubjectTags = editSubjectTags;
        window.setCycleTagFilter = setCycleTagFilter;
        window.showInputModal = showInputModal;

        window.setViewMode = setViewMode;
        window.scrollTabs = scrollTabs;
        window.switchSubject = switchSubject;
        window.openSubject = openSubject;
        window.openSubjectByIndex = openSubjectByIndex;

        window.showMobileMoreMenu = showMobileMoreMenu;
        window.importWithPicker = importWithPicker;
        window.exportToXLSX = exportToXLSX;
        window.resetRevision = resetRevision;
        window.toggleDominated = toggleDominated;
        window.showSessionModal = showSessionModal;
        window.copyTopicReference = copyTopicReference;
        window.startRandomTest = startRandomTest;
        window.toggleCardPriority = toggleCardPriority;

        window.toggleConcluido = toggleConcluido;

        window.toggleAgendaReview = toggleAgendaReview;
        window.setAgendaReviewPage = setAgendaReviewPage;
        window.editTopicQuestionTotals = editTopicQuestionTotals;
        window.resetAllData = resetAllData;
        window.skipCycleItem = skipCycleItem;
        window.addSubjectsFromPastedText = addSubjectsFromPastedText;
        window.appendImportWithPicker = appendImportWithPicker;

        window.setSubjectTopicSortMode = setSubjectTopicSortMode;
        window.moveTopicUpInSubject = moveTopicUpInSubject;
        window.moveTopicDownInSubject = moveTopicDownInSubject;
        window.toggleHiddenEverywhere = toggleHiddenEverywhere;
        // -----------------------------
        // Init
        // -----------------------------
        function init() {
            document.documentElement.classList.toggle('dark', isDarkMode);
            updateThemeIcons();
            loadAppConfig();
            updateStats();
            updateViewButtons();
            renderChart();
            renderAppVersion();
            updateLearningHeader();

            edital.forEach((s, i) => {
                if (!Array.isArray(s.tags)) s.tags = [];
                s.tags = normalizeTagsList(s.tags);
                // Recurso de anotações removido: limpa dados antigos desse campo no próximo save.
                if (Object.prototype.hasOwnProperty.call(s, 'themeNotes')) delete s.themeNotes;
                s.hiddenEverywhere = s.hiddenEverywhere === true;

                // ✅ PASSO 1.2 (garante order 1..100)
                if (typeof s.order !== "number" || !Number.isFinite(s.order)) {
                    s.order = Math.min(100, Math.max(1, i + 1)); // padrão: 1,2,3...
                } else {
                    s.order = Math.min(100, Math.max(1, Math.round(s.order)));
                }
            });

            save();


            renderCurrentView();
            syncMobileNavigation();

            const isPlaceholder = edital.length === 1 && edital[0].materia === "Materia lorem ipsum";
            if (isPlaceholder) {
                showModal(
                    "Importe sua planilha",
                    "Você está usando o edital default.\nClique em Importar para carregar seu edital verticalizado."
                );
            }
        }

        let mobileResizeTimer = null;
        window.addEventListener('resize', () => {
            clearTimeout(mobileResizeTimer);
            mobileResizeTimer = setTimeout(() => {
                renderCurrentView();
                syncMobileNavigation();
            }, 120);
        });

        window.onload = init;
    </script>
