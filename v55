        // -----------------------------
        // Delete topic
        // -----------------------------
        function deleteTopicByIndex(sIdx, tIdx) {
            const subject = edital?.[sIdx];
            if (!subject || !Array.isArray(subject.topicos)) return;
            if (tIdx < 0 || tIdx >= subject.topicos.length) return;

            const oldLength = subject.topicos.length;

            // Mantém a ordem manual, removendo o tópico excluído e corrigindo
            // os índices dos tópicos que estavam depois dele.
            const oldOrder = getTopicOrderForSubject(sIdx);
            const adjustedOrder = oldOrder
                .filter(index => index !== tIdx)
                .map(index => index > tIdx ? index - 1 : index);

            // Remove o tópico do edital.
            subject.topicos.splice(tIdx, 1);

            // Remove o progresso do tópico apagado e desloca os dados dos
            // tópicos seguintes para que continuem ligados ao texto correto.
            for (let index = tIdx; index < oldLength - 1; index++) {
                const currentKey = `ST_${sIdx}_${index}`;
                const nextKey = `ST_${sIdx}_${index + 1}`;

                if (Object.prototype.hasOwnProperty.call(userProgress, nextKey)) {
                    userProgress[currentKey] = userProgress[nextKey];
                } else {
                    delete userProgress[currentKey];
                }
            }
            delete userProgress[`ST_${sIdx}_${oldLength - 1}`];

            // Salva a fila corrigida. Caso a matéria fique vazia, salva uma fila vazia.
            setTopicOrderForSubject(sIdx, adjustedOrder);

            save();
            showModal(
                "Tópico excluído",
                "O tópico e os dados ligados a ele foram apagados. A exclusão também será refletida no próximo backup exportado."
            );
        }

