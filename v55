                        const exists = selectedTags.some((item) => normKey(item) === key);
                        const next = exists
                            ? selectedTags.filter((item) => normKey(item) !== key)
                            : [...selectedTags, tag];

                        input.value = normalizeTagsList(next).join(', ');
                        renderExistingTagButtons();
                    };
                    tagBox.appendChild(button);
                });
            }

            input.addEventListener('input', renderExistingTagButtons);
            renderExistingTagButtons();
