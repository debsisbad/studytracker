            }

            function renderExistingTagButtons() {
                const selected = currentSelectedKeys();
                tagBox.innerHTML = '';

                if (!allTags.length) {
                    const empty = document.createElement('span');
                    empty.className = 'text-xs text-gray-500 dark:text-slate-400';
