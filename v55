        function agendaReviewTitle(i) {
            const n = i + 1;
            const days = getAgendaReviewDays(false);
            const previous = i === 0 ? 0 : days[i - 1];
            const interval = days[i] - previous;
            return `${n}ª (${interval}d)`;
        }

        function revisionIntervalDays(countR) {
            if (learningConfig.mode === 'final') return 7;
            return countR < 5 ? 25 : 50;
        }
        function nextRevisionDate(progress) {
            if (!progress) return null;
            const last = toTs(progress.lastR);
            const c = progress.countR || 0;
            if (!last || !c) return null;
            const base = new Date(last);
            base.setDate(base.getDate() + revisionIntervalDays(c));
            return base;
        }

        // Próxima revisão planejada baseada na data da AULA e no nº de revisões já feitas
        function nextPlannedReviewDate(st) {
            if (!st) return null;

            const aula = toTs(st.aulaAt);
            if (!aula) return null;

            const days = getAgendaReviewDays(!!st.dominated).filter(d => d !== null);
            const done = normalizeAgendaDone(st.agendaDone);
            const original = getAgendaReviewDays(!!st.dominated);
            for (let i = 0; i < original.length; i++) {
                if (original[i] !== null && !done[i]) return addDays(aula, original[i]);
            }
            return null;
        }

        function getNextPendingAgendaDate(st) {
            if (!st) return null;

            const aula = toTs(st.aulaAt);
            if (!aula) return null;

            const isDominated = !!st.dominated;
            const days = getAgendaReviewDays(isDominated);
            const planned = days.map(d => d === null ? null : addDays(aula, d));

            const agendaDone = Array.isArray(st.agendaDone)
                ? st.agendaDone
                : Array(days.length).fill(false);

            for (let i = 0; i < planned.length; i++) {
                if (!planned[i]) continue;
                if (!agendaDone[i]) return planned[i];
            }

            return null;
        }

        // normaliza texto
        function normKey(s) {
            return String(s || "")
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .replace(/\s+/g, " ")
                .trim();
        }

        function parseStorageKey(k) {
            const m = String(k || "").match(/^ST_(\d+)_(\d+)$/);
            if (!m) return null;
            return { sIdx: Number(m[1]), tIdx: Number(m[2]) };
        }

        function parseNumPath(text) {
            const s = String(text || "").trim();

            // pega "1", "1.1", "1.1.2" no começo, aceitando:
            // "1. ...", "1) ...", "1 - ...", "1.1 ...", "1.1. ...", "1.1) ..."
            const m = s.match(/^(\d+(?:\.\d+)*)(?=[\.\)\-\s])/);
            if (!m) return null;

            return m[1].split('.');
        }


        function getChildrenTopicIndices(sIdx, parentTIdx) {
            const s = edital?.[sIdx];
            if (!s || !Array.isArray(s.topicos)) return [];

            const parentText = s.topicos[parentTIdx];
            const parentPath = parseNumPath(parentText);
            if (!parentPath) return [];

            const parentNum = parentPath.join('.'); // ex: "1" ou "1.2"

            const out = [];
            for (let i = 0; i < s.topicos.length; i++) {
                if (i === parentTIdx) continue;

                const childPath = parseNumPath(s.topicos[i]);
                if (!childPath) continue;

                const childNum = childPath.join('.');

                // filho tem que começar com "pai." e ter mais níveis
                // ex: pai=1 → filho=1.1
                //     pai=1.2 → filho=1.2.3
                if (childNum.startsWith(parentNum + ".") && childPath.length > parentPath.length) {
                    out.push(i);
                }
            }

            return out;
        }


        function getTopicPctByKey(storageKey) {
            const st = userProgress?.[storageKey];
            const p = st?.pct;
            return (typeof p === "number" && Number.isFinite(p)) ? p : null;
        }

        function subjectPctScore(sIdx) {
            const s = edital[sIdx];
            if (!s || !Array.isArray(s.topicos)) return -1;

            let sum = 0;
            let n = 0;

            s.topicos.forEach((t, tIdx) => {
                const k = `ST_${sIdx}_${tIdx}`;
                const p = getTopicPctByKey(k);
                if (p !== null) { sum += p; n++; }
            });

            return n ? (sum / n) : -1;
        }

        function getSubjectOrderByPct() {
            return edital
                .map((s, idx) => ({ s, idx, score: subjectPctScore(idx) }))
                .filter(({ s }) => !isHiddenEverywhere(s))
                .sort((a, b) => {
                    const as = a.score < 0 ? 101 : a.score;
                    const bs = b.score < 0 ? 101 : b.score;
                    return (as - bs) || (a.idx - b.idx);
                })
                .map(x => x.idx);
        }

        function getTopicOrderByPctWithinSubject(sIdx) {
            const s = edital[sIdx];
            if (!s || !Array.isArray(s.topicos)) return [];

            return s.topicos
                .map((_, tIdx) => {
                    const p = getTopicPctByKey(`ST_${sIdx}_${tIdx}`);
                    return { tIdx, p: (p === null ? -1 : p) };
                })
                .sort((a, b) => {
                    const ap = a.p < 0 ? 101 : a.p;
                    const bp = b.p < 0 ? 101 : b.p;
                    return (ap - bp) || (a.tIdx - b.tIdx);
                })
                .map(x => x.tIdx);
        }
        function getTopicOrderFixedWithinSubject(sIdx) {
            const s = edital[sIdx];
