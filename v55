        function isHiddenInCycle(s) {
            return isHiddenEverywhere(s) || s?.hiddenInCycle === true;
        }

        // Agenda: ocultação independente do Ciclo Intercalado
        function isHiddenInAgenda(s) {
            return isHiddenEverywhere(s) || s?.hiddenInAgenda === true;
        }

