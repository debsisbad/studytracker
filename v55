            const noRepeat = document.getElementById('error-result-no-repeat')?.checked === true;
            const nextDays = [3, 10, 25].includes(Number(document.getElementById('error-result-next-days')?.value))
                ? Number(document.getElementById('error-result-next-days').value)
                : 3;
            const now = Date.now();
            const result = { at: now, total, correct, outcome };
            if (!session.errorReviewDone || typeof session.errorReviewDone !== 'object') session.errorReviewDone = {};
            if (!session.errorReviewResults || typeof session.errorReviewResults !== 'object') session.errorReviewResults = {};
            if (!Array.isArray(session.errorReviewRetries)) session.errorReviewRetries = [];
            if (!Array.isArray(session.secureErrorReviewDates)) session.secureErrorReviewDates = [];

            const retry = retryId ? session.errorReviewRetries.find(item => String(item.id) === String(retryId)) : null;
            if (retry) { retry.done = true; retry.result = result; }
            else { session.errorReviewDone[days] = true; session.errorReviewResults[days] = result; }

            if (outcome === 'secure') {
                const dayKey = new Date(now); dayKey.setHours(0, 0, 0, 0);
                session.secureErrorReviewDates = [...new Set([...session.secureErrorReviewDates, dayKey.getTime()])];
            } else {
                session.secureErrorReviewDates = [];
            }
            session.errorCorrected = noRepeat;
            if (noRepeat) {
                session.errorReviewDays.forEach(day => { session.errorReviewDone[day] = true; });
                session.errorReviewRetries.forEach(item => { item.done = true; });
            } else {
                session.errorReviewRetries.push({
                    id: `ER_${now}_${Math.random().toString(36).slice(2, 7)}`,
                    days: nextDays,
                    dueAt: addDays(now, nextDays),
                    done: false,
                    result: null
                });
            }
            document.getElementById('custom-modal').style.display = 'none';
            save();
        }

        function topicSessions(st) {
            return Array.isArray(st?.sessions) ? st.sessions.map(normalizeSession) : [];
        }

        function sessionPercent(session) {
            const total = Number(session?.questions) || 0;
            return total > 0 ? Math.round(((Number(session.correct) || 0) / total) * 100) : null;
        }

        function recentTopicPercent(st, limit = 3) {
            const manual = st?.questionStatsOverride;
            if (manual && typeof manual === 'object') {
                const questions = Math.max(0, Math.round(Number(manual.questions) || 0));
                const correct = Math.max(0, Math.min(questions, Math.round(Number(manual.correct) || 0)));
                return questions ? Math.round((correct / questions) * 100) : null;
            }
            const scored = topicSessions(st).filter(s => sessionPercent(s) !== null).slice(-limit);
            if (!scored.length) return (typeof st?.pct === 'number' ? st.pct : null);
            const q = scored.reduce((sum, s) => sum + s.questions, 0);
            const a = scored.reduce((sum, s) => sum + s.correct, 0);
            return q ? Math.round((a / q) * 100) : null;
        }

        function masteryEvidence(st) {
            const target = Number(learningConfig.masteryTarget) || 80;
            const scored = topicSessions(st).filter(s => sessionPercent(s) !== null && !s.consulted);
            const lastThree = scored.slice(-3);
            const distinctDays = new Set(lastThree.map(s => new Date(s.at).toISOString().slice(0, 10))).size;
            const pct = recentTopicPercent({ ...st, sessions: lastThree }, 3);
            const manual = st?.questionStatsOverride;
            const manualProbable = manual && Number(manual.questions) > 0 && pct !== null && pct >= target;
            const probable = manualProbable || (lastThree.length >= 3 && distinctDays >= 3 && pct !== null && pct >= target && lastThree.every(s => sessionPercent(s) >= 70));
            return { probable, pct, tests: scored.length, distinctDays };
        }

        function topicQuestionTotals(st) {
            const manual = st?.questionStatsOverride;
            if (manual && Number(manual.questions) >= 0) {
                const questions = Math.max(0, Math.round(Number(manual.questions) || 0));
                const correct = Math.max(0, Math.min(questions, Math.round(Number(manual.correct) || 0)));
                return { questions, correct, manual: true };
            }
            const scored = topicSessions(st).filter(session => session.questions > 0);
            return {
                questions: scored.reduce((sum, session) => sum + session.questions, 0),
                correct: scored.reduce((sum, session) => sum + session.correct, 0),
                manual: false
            };
        }

        function learningStatus(st) {
            const ev = masteryEvidence(st || {});
            if ((ev.probable || st?.dominated) && isLearningStatusEnabled('strong')) return { label: 'FORTE', cls: 'learning-strong' };
            if (ev.pct !== null && ev.pct < 70 && isLearningStatusEnabled('fragile')) return { label: 'FRÁGIL', cls: 'learning-fragile' };
            if (ev.pct !== null && isLearningStatusEnabled('building')) return { label: 'CONSOLIDANDO', cls: 'learning-building' };
            if (st?.q && isLearningStatusEnabled('seen')) return { label: 'VISTO', cls: 'learning-seen' };
            return null;
        }

